{
  "name": "questly-app",
  "version": "1.0.0",
  "description": "Questions and answers app",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/main/server.js",
    "dev": "tsx src/main/server.ts",
    "migration:create": "tsx src/infra/database/postgres/scripts/create-migration.ts",
    "migration:create:prod": "node src/infra/database/postgres/scripts/create-migration.js",
    "migrate": "tsx src/infra/database/postgres/scripts/run-migrations.ts",
    "migrate:prod": "node dist/infra/database/postgres/scripts/run-migrations.js",
    "docker:up:db": "docker compose up -d postgres",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "docker:up:build": "docker compose up --build -d",
    "test": "vitest --passWithNoTests",
    "test:unit": "npm test -- --watch --config vitest-unit-config.js",
    "test:int": "npm test -- --watch --config vitest-integration-config.js",
    "test:staged": "vitest related --run --passWithNoTests",
    "test:coverage": "npm test -- --run --coverage",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.3.0",
    "@testcontainers/postgresql": "^10.21.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "git-commit-msg-linter": "^5.0.8",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "pg": "^8.20.0",
    "uuid": "^14.0.0",
    "validator": "^13.15.35"
  }
}
